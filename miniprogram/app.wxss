page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfaf6 0%, #eef4f2 54%, #f8f5ef 100%);
  color: #172026;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 16rpx;
  line-height: 1.35;
}

button::after {
  border: 0;
}

.page {
  padding: 28rpx 28rpx 48rpx;
}

.eyebrow {
  color: #0a5c55;
  font-size: 24rpx;
  font-weight: 700;
}

.h1 {
  margin-top: 12rpx;
  color: #172026;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.16;
}

.h2 {
  color: #172026;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.muted {
  color: #65717a;
  line-height: 1.65;
}

.card {
  border: 1rpx solid #dbe4df;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 42rpx rgba(23, 32, 38, 0.08);
}

.primary-btn {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  background: #0f766e;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(15, 118, 110, 0.18);
}

.ghost-btn {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dbe4df;
  background: #ffffff;
  color: #172026;
  font-size: 30rpx;
  font-weight: 700;
}

.danger {
  color: #c75146;
}

.warning {
  color: #b98212;
}

.calm {
  color: #256a7b;
}
