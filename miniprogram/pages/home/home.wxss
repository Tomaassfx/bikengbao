.hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  border: 1rpx solid #c7d4cc;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 90% 8%, rgba(10, 118, 107, 0.16), transparent 280rpx),
    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(246, 250, 247, 0.92));
  padding: 34rpx;
  box-shadow: 0 22rpx 52rpx rgba(19, 34, 32, 0.1);
}

.hero .h1 {
  font-size: 56rpx;
}

.audit-brief {
  display: grid;
  grid-template-columns: 164rpx 1fr;
  gap: 20rpx;
  margin-top: 18rpx;
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(241, 193, 95, 0.16), transparent 220rpx),
    linear-gradient(180deg, #152522, #0e1817);
  padding: 22rpx;
}

.brief-score {
  display: flex;
  width: 144rpx;
  height: 144rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 12rpx solid rgba(241, 193, 95, 0.24);
  border-top-color: #f1c15f;
  border-radius: 20rpx;
}

.brief-score text:first-child {
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
}

.brief-score text:last-child {
  margin-top: 8rpx;
  color: #cbd6d4;
  font-size: 22rpx;
}

.brief-list {
  display: flex;
  justify-content: center;
  flex-direction: column;
  gap: 12rpx;
}

.brief-list text {
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #eef5f2;
  padding: 12rpx 16rpx;
  font-size: 25rpx;
}

.upload {
  display: flex;
  min-height: 280rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 14rpx;
  border-style: dashed;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.66), rgba(227, 241, 237, 0.44)),
    #f6fbf9;
  padding: 34rpx;
  text-align: center;
}

.upload-icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #11877b, #074e49);
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 300;
}

.upload-title {
  color: #172322;
  font-size: 32rpx;
  font-weight: 800;
}

.file-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 20rpx 0;
}

.file-pill {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: 18rpx;
  background: #e3f1ed;
  padding: 16rpx 18rpx;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 24rpx;
  padding: 28rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field > text {
  color: #2d3b41;
  font-size: 26rpx;
  font-weight: 700;
}

input,
textarea,
.picker {
  width: 100%;
  min-height: 88rpx;
  border: 1rpx solid #cfdad5;
  border-radius: 18rpx;
  background: #ffffff;
  color: #172322;
  padding: 22rpx;
}

textarea {
  min-height: 220rpx;
  line-height: 1.55;
}

.sample-btn {
  margin-top: 8rpx;
}

.metrics {
  margin-top: 24rpx;
  padding: 28rpx;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.metric-row > view {
  display: flex;
  min-height: 132rpx;
  justify-content: center;
  flex-direction: column;
  border-radius: 18rpx;
  background: #f6f8f4;
  padding: 16rpx;
}

.metric-value {
  color: #074e49;
  font-size: 34rpx;
  font-weight: 800;
}

@media (max-width: 360px) {
  .audit-brief {
    grid-template-columns: 1fr;
  }
}
